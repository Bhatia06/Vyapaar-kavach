# ---------------------------------------------------------------------------
# Vyapaar Kavach — environment template. Copy to `.env` (or export variables
# in your shell). NO real secrets are required for the synthetic demo.
# ---------------------------------------------------------------------------

# Database. Default: local SQLite file (zero dependencies).
# For Postgres (see compose.yaml):
#   DATABASE_URL=postgresql+psycopg2://vyapaar:vyapaar@localhost:5432/vyapaar
DATABASE_URL=sqlite:///./vyapaar.db

# Application environment/mode. This build only supports DEMO_LOCAL.
# All demo data is synthetic and all provider calls hit the bundled mock.
APP_ENVIRONMENT=DEMO_LOCAL

# Demo user passwords (seeded locally ONLY; never used in any real deployment).
DEMO_OWNER_PASSWORD=owner123
DEMO_STAFF_PASSWORD=staff123
DEMO_RESEARCHER_PASSWORD=research123

# ML artifacts (original-domain GATv2 research engine).
ML_DATASET_PATH=../dataset1 (1).pt
ML_CHECKPOINT_PATH=../GAT_Model_Final (2).pt
ML_ARTIFACTS_DIR=ml/artifacts

# Where evidence exports are written (relative to repo root).
EXPORTS_DIR=services/api/artifacts/exports

# Session cookie security: set true only behind HTTPS (defaults false for local demo).
SESSION_SECURE=false
